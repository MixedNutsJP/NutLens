<Window x:Class="NutLens.App.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:NutLens.App.Resources"
        Title="{x:Static res:Strings.ResultWindowTitle}"
        Width="820"
        Height="780"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!--
            選択してコピーできる文字（利用者の要望）。
            題名をそのまま検索に貼れるようにするため。

            WPF の TextBlock は選択できないので、枠を消した読み取り専用の TextBox にする。
            見た目は TextBlock と同じにしたいので、枠・背景・余白を消す。

            スクロールバーを Disabled にしているのは、内側の ScrollViewer に
            マウスホイールを飲ませないため。**飲まれると結果画面がスクロールしなくなる。**
        -->
        <Style TargetType="TextBox" x:Key="SelectableText">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>

        <!-- 箇条書き 1 件。「・」は TextBox の外に出す（コピーに混ざらないように） -->
        <DataTemplate x:Key="BulletTemplate">
            <DockPanel Margin="0,1">
                <TextBlock Text="・" DockPanel.Dock="Left" VerticalAlignment="Top" />
                <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableText}" />
            </DockPanel>
        </DataTemplate>

        <!--
            参考 URL 1 件（クリックで開く。F-26）。
            ここだけは Hyperlink のまま。TextBox にするとクリックで開けなくなる。
            コピーは右クリックから。
        -->
        <DataTemplate x:Key="SourceTemplate">
            <TextBlock Margin="0,1" TextWrapping="Wrap">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static res:Strings.Copy}"
                                  Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Mode=OneWay}" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
                <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                           CommandParameter="{Binding Mode=OneWay}">
                    <Run Text="{Binding Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </DataTemplate>

        <!-- 候補 1 件 -->
        <DataTemplate x:Key="CandidateTemplate">
            <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <!-- 題名はそのまま検索に貼れるよう、選択してコピーできるようにする -->
                    <TextBox Text="{Binding Title, Mode=OneWay}"
                             Style="{StaticResource SelectableText}"
                             FontSize="16"
                             FontWeight="SemiBold" />
                    <TextBox Text="{Binding Subtitle, Mode=OneWay}"
                             Style="{StaticResource SelectableText}"
                             Opacity="0.75"
                             Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ConfidenceText}" Margin="0,6,0,0" />
                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Confidence, Mode=OneWay}" Margin="0,4,0,0" />

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static res:Strings.ResultEvidence}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Evidence}" ItemTemplate="{StaticResource BulletTemplate}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasMismatches, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static res:Strings.ResultMismatches}" FontWeight="SemiBold" Foreground="#FFB00020" />
                        <ItemsControl ItemsSource="{Binding Mismatches}" ItemTemplate="{StaticResource BulletTemplate}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static res:Strings.ResultSources}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource SourceTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 失敗したとき：生の出力を出す（ADR-0012 決定 2） -->
                <StackPanel Visibility="{Binding Failed, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#FFB00020" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Strings.ResultRawOutput}" Style="{StaticResource SectionHeader}" />
                    <TextBox Text="{Binding RawOutput, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas, Meiryo, monospace"
                             Height="220"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </StackPanel>

                <TextBlock Text="{x:Static res:Strings.ResultNoCandidates}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Visibility="{Binding HasNoCandidates, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static res:Strings.ResultTopCandidate}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Candidates}" ItemTemplate="{StaticResource CandidateTemplate}" />
                </StackPanel>

                <StackPanel Visibility="{Binding Succeeded, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static res:Strings.ResultObservedFeatures}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding ObservedFeatures}" ItemTemplate="{StaticResource BulletTemplate}" />

                    <TextBlock Text="{x:Static res:Strings.ResultUnverifiedPoints}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding UnverifiedPoints}" ItemTemplate="{StaticResource BulletTemplate}" />

                    <TextBlock Text="{x:Static res:Strings.ResultSearchQueries}" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding SearchQueries}" ItemTemplate="{StaticResource BulletTemplate}" />
                </StackPanel>

                <TextBlock Text="{Binding RunInfoText}" Opacity="0.75" Margin="0,16,0,0" />

                <!-- 再調査（F-27） -->
                <!-- 5.6：Web Detection を使ったかどうか。使っていなければ行ごと出さない -->
                <TextBlock Text="{Binding WebDetectionNotice}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"
                           Opacity="0.8"
                           Visibility="{Binding HasWebDetectionNotice, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{x:Static res:Strings.ReinvestigateHeader}" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="{x:Static res:Strings.ReinvestigateHint}" TextWrapping="Wrap" Opacity="0.8" />
                <TextBox Text="{Binding AdditionalInformation, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="72"
                         Margin="0,6,0,0"
                         VerticalScrollBarVisibility="Auto" />
                <Button Content="{x:Static res:Strings.Reinvestigate}"
                        Command="{Binding ReinvestigateCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0" />

                <!-- この解析のデータについて（ADR-0013 決定 2） -->
                <Expander Header="{x:Static res:Strings.DataNoticeHeader}" Margin="0,18,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{x:Static res:Strings.DataNoticeDeleted}" TextWrapping="Wrap" />

                        <StackPanel Visibility="{Binding HasTranscript, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Strings.DataNoticeTranscript}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBox Text="{Binding TranscriptPath, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Margin="0,6,0,0"
                                     FontFamily="Consolas, Meiryo, monospace" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{x:Static res:Strings.CopyPath}" Command="{Binding CopyTranscriptPathCommand}" />
                                <Button Content="{x:Static res:Strings.OpenContainingFolder}" Command="{Binding OpenTranscriptFolderCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{x:Static res:Strings.DataNoticeTranscriptNotFound}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Opacity="0.8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTranscript}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.ResultSaveMarkdown}" Command="{Binding SaveMarkdownCommand}" />
                <Button Content="{x:Static res:Strings.Close}" IsCancel="True" Margin="0" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.85" />
        </DockPanel>
    </Grid>
</Window>
