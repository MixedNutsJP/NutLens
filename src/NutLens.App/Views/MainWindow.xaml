<Window x:Class="NutLens.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:NutLens.App.Resources"
        xmlns:vm="clr-namespace:NutLens.App.ViewModels"
        xmlns:views="clr-namespace:NutLens.App.Views"
        Title="{x:Static res:Strings.AppTitle}"
        Width="640"
        Height="620"
        MinWidth="560"
        MinHeight="560"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:EnumToBooleanConverter x:Key="ModeConverter" />
        <views:InverseBooleanConverter x:Key="InverseBool" />

        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Padding" Value="4,3" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 撮影する対象 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{x:Static res:Strings.TargetSectionHeader}" Style="{StaticResource SectionHeader}" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="{x:Static res:Strings.TargetKindWindow}"
                             GroupName="TargetKind"
                             Margin="0,0,16,0"
                             IsChecked="{Binding Mode, Converter={StaticResource ModeConverter}, ConverterParameter={x:Static vm:TargetSelectionMode.Window}}" />
                <RadioButton Content="{x:Static res:Strings.TargetKindMonitor}"
                             GroupName="TargetKind"
                             Margin="0,0,16,0"
                             IsChecked="{Binding Mode, Converter={StaticResource ModeConverter}, ConverterParameter={x:Static vm:TargetSelectionMode.Monitor}}" />
                <RadioButton Content="{x:Static res:Strings.TargetKindRegion}"
                             GroupName="TargetKind"
                             IsChecked="{Binding Mode, Converter={StaticResource ModeConverter}, ConverterParameter={x:Static vm:TargetSelectionMode.Region}}" />
            </StackPanel>

            <Grid Visibility="{Binding IsListMode, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Targets}"
                          SelectedItem="{Binding SelectedTarget}"
                          DisplayMemberPath="Title"
                          IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBool}}" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="{x:Static res:Strings.RefreshTargets}"
                        Command="{Binding RefreshCommand}" />
            </Grid>

            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsRegionMode, Converter={StaticResource BoolToVisibility}}">
                <Button Content="{x:Static res:Strings.SelectRegion}" Command="{Binding SelectRegionCommand}" />
                <TextBlock Text="{Binding RegionDescription}" VerticalAlignment="Center" />
            </StackPanel>

            <!--
                撮り方で結果が大きく変わる（ADR-0015 背景）。
                ブラウザの窓ごと撮ると、動かない部分が画面の大半を占めて重複判定が効かなくなる。
            -->
            <TextBlock Text="{x:Static res:Strings.FramingHint}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Opacity="0.75" />
        </StackPanel>

        <!-- 2. 撮影の条件 -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="{x:Static res:Strings.SettingsSectionHeader}" Style="{StaticResource SectionHeader}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.IntervalSeconds}" Style="{StaticResource FieldLabel}" />
                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Static res:Strings.DurationSeconds}" Style="{StaticResource FieldLabel}" />
                <TextBox   Grid.Row="0" Grid.Column="4" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.DuplicateThreshold}" Style="{StaticResource FieldLabel}" />
                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding DuplicateThreshold, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Static res:Strings.MaxFrames}" Style="{StaticResource FieldLabel}" />
                <TextBox   Grid.Row="1" Grid.Column="4" Text="{Binding MaxFrames, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.LongEdgePixels}" Style="{StaticResource FieldLabel}" />
                <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding LongEdgePixels, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- 段階 3：録音（F-11 / ADR-0016 決定 4〜5） -->
            <CheckBox Content="{x:Static res:Strings.RecordAudio}"
                      IsChecked="{Binding RecordAudio}"
                      IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBool}}"
                      Margin="0,10,0,0" />
            <TextBlock Text="{x:Static res:Strings.AudioNotice}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Opacity="0.75" />

            <!--
                段階 4：残りの設定は設定画面へ移した（ADR-0021 決定 5 の「段階 4 で移す」）。
                「高度な設定（上級者向け）」の見出しは、設定画面のタブ名として出している（5.6）。
            -->
            <Button Content="{x:Static res:Strings.TraySettings}"
                    Click="OnOpenSettingsClick"
                    HorizontalAlignment="Left"
                    Margin="0,14,0,0" />
        </StackPanel>

        <!-- 3. 撮影 -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="{x:Static res:Strings.RunSectionHeader}" Style="{StaticResource SectionHeader}" />

            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.StartCapture}" Command="{Binding StartCommand}" />
                <Button Content="{x:Static res:Strings.StopCapture}" Command="{Binding StopCommand}" />
                <Button Content="{x:Static res:Strings.OpenFolder}" Command="{Binding OpenFolderCommand}" />
                <Button Content="{x:Static res:Strings.Analyze}" Command="{Binding AnalyzeCommand}" FontWeight="SemiBold" />
            </StackPanel>

            <ProgressBar Height="6"
                         Margin="0,12,0,0"
                         Minimum="0"
                         Maximum="1"
                         Value="{Binding ProgressRatio, Mode=OneWay}" />

            <TextBlock Text="{Binding Status}" Margin="0,10,0,0" TextWrapping="Wrap" />

            <!-- できなかったこと（段階 3）。警告色にはしない -->
            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,1">
                            <Run Text="・" /><Run Text="{Binding Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 注意書き（要件 5.5） -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="{x:Static res:Strings.PrivacyNotice}"
                       TextWrapping="Wrap"
                       Opacity="0.75" />
            <TextBlock Text="{x:Static res:Strings.KeepTemporaryDataWarning}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Foreground="#FFB00020"
                       Visibility="{Binding KeepTemporaryData, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</Window>
