<Window x:Class="NutLens.App.Views.RegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:NutLens.App.Resources"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#30000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross"
        WindowStartupLocation="Manual">

    <Grid>
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionRectangle"
                       Stroke="#FF4FC3F7"
                       StrokeThickness="2"
                       Fill="#204FC3F7"
                       Visibility="Collapsed" />
        </Canvas>

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,40,0,0"
                Padding="16,8"
                CornerRadius="4"
                Background="#CC000000">
            <TextBlock Text="{x:Static res:Strings.RegionOverlayHint}"
                       Foreground="White"
                       FontSize="14" />
        </Border>
    </Grid>
</Window>
