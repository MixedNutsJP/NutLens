<Window x:Class="NutLens.App.Views.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:NutLens.App.Resources"
        Title="{x:Static res:Strings.WebDetectionKeyPromptTitle}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="{x:Static res:Strings.WebDetectionKeyPromptBody}"
                   TextWrapping="Wrap"
                   Opacity="0.85" />

        <!--
            PasswordBox を使う。TextBox だと肩越しに見えるうえ、
            Text が依存関係プロパティなので束縛や自動化の経路に平文で乗る（ADR-0020）。
        -->
        <PasswordBox x:Name="KeyBox" Margin="0,14,0,0" Padding="6,4" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static res:Strings.Cancel}"
                    IsCancel="True"
                    Padding="14,6"
                    Margin="0,0,8,0" />
            <Button Content="{x:Static res:Strings.Save}"
                    IsDefault="True"
                    Click="OnSaveClick"
                    Padding="14,6" />
        </StackPanel>
    </StackPanel>
</Window>
